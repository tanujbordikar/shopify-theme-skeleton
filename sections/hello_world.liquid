<div>
  <b>
    {% for menu in section.blocks %}
      {{ menu.settings.menu_title }}
    {% endfor -%}
    }
  </b>
  <h1>
    {{ section.settings.section_title }}
  </h1>
</div>

{% schema %}
{
  "name": "Hello World name",
  "settings": [
      {
        "type": "text",
        "id": "section_title",
        "label": "Section Title",
        "default": "Hello World"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings":[
        {
          "type": "text",
          "id": "menu-title",
          "label": "Menu Title Header",
          "default": "Home"
        }
      ],
    }
  ],
    "presets": [
  {
    "category": "Custom",
    "name": "Hello World Display"
  }
]
}
{% endschema %}
